# ── GCP Project ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# ── BigQuery ─────────────────────────────────────────────────────────────────
BQ_DATASET_ID=banking_demo
BQ_TABLE_ID=sales_data
BQ_MAX_ROWS=100

# ── Vertex AI / Gemini ────────────────────────────────────────────────────────
# Available: gemini-2.0-flash-001, gemini-1.5-pro-001, gemini-1.5-flash-001
GEMINI_MODEL=gemini-2.0-flash-001

# ── Documents ────────────────────────────────────────────────────────────────
DOCS_PATH=data/documents

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_TTL=300

# ── Local Testing ─────────────────────────────────────────────────────────────
# Set to "true" to run without GCP credentials (uses mock data)
USE_MOCK_DATA=true
